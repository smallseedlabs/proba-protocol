            },
            "details": {
              "type": "object",
              "additionalProperties": {}
            },
            "tags": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "content": {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]{0,63}$"
                },
                "text": {
                  "type": "string",
                  "maxLength": 16384
                },
                "truncated": {
                  "type": "boolean"
                },
                "originalLength": {
                  "type": "integer",
                  "minimum": 0
                },
                "redactions": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "kind",
                "text",
                "truncated",
                "originalLength",
                "redactions"
              ],
              "additionalProperties": false
            },
            "prevHash": {

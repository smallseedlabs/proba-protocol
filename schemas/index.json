    },
    "ServerUI": {
      "$ref": "#/definitions/ServerUI",
      "definitions": {
        "ServerUI": {
          "type": "object",
          "properties": {
            "component": {
              "type": "string",
              "enum": [
                "text",
                "plan_card",
                "approval_card",
                "question_choice",
                "question_text",
                "metric_tile",
                "metric_chart",
                "table",
                "spend_bar",
                "status_banner",
                "alert",
                "timeline_item",
                "goal_summary",
                "form",
                "number_input",
                "select",
                "confirm"
              ]
            },
            "version": {
              "type": "string",
              "pattern": "^\\d+\\.\\d+\\.\\d+$"
            },
            "props": {},
            "actions": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "label": {
                    "type": "string"
                  },
                  "style": {
                    "type": "string",
                    "enum": [
                      "primary",
                      "default",
                      "danger"
                    ]
                  },
                  "command": {
                    "type": "object",
                    "additionalProperties": {}
                  },
                  "opens": {
                    "$ref": "#/definitions/ServerUI"
                  }
                },
                "required": [
                  "id",
                  "label"
                ],
                "additionalProperties": false
              }
            }

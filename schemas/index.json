        }
      },
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "ServerUI": {
      "$ref": "#/definitions/ServerUI",
      "definitions": {
        "ServerUI": {
          "type": "object",
          "properties": {
            "component": {
              "type": "string",
              "enum": [
                "text",
                "plan_card",
                "approval_card",
                "question_choice",
                "question_text",
                "metric_tile",
                "metric_chart",
                "table",
                "spend_bar",
                "status_banner",
                "alert",
                "timeline_item",
                "goal_summary",
                "form",
                "number_input",
                "select",
                "confirm"
              ]

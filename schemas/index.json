    "AuditEvent": {
      "$ref": "#/definitions/AuditEvent",
      "definitions": {
        "AuditEvent": {
          "type": "object",
          "properties": {
            "version": {
              "type": "number",
              "const": 1
            },
            "eventId": {
              "type": "string",
              "format": "uuid"
            },
            "traceId": {
              "type": "string",
              "format": "uuid"
            },
            "spanId": {
              "type": "string",
              "pattern": "^[0-9a-f]{16}$"
            },
            "parentSpanId": {
              "$ref": "#/definitions/AuditEvent/properties/spanId"
            },
            "workspaceId": {
              "type": "string",
              "minLength": 1
            },
            "userId": {
              "type": "string",
              "format": "uuid"
            },
            "goalId": {
              "type": "string",
              "format": "uuid"
            },
            "threadId": {
              "type": "string",
              "format": "uuid"
            },
            "campaignId": {
              "type": "string",
              "minLength": 1
            },
            "actor": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "user",
                    "brain",
                    "system",
                    "service"
                  ]
                },
                "id": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "type",
                "id"
              ],
              "additionalProperties": false
            },
            "service": {
              "type": "string",
              "minLength": 1
            },
            "action": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
            },
            "category": {
              "type": "string",
              "enum": [
                "command",
                "brain",
                "tool",
                "policy",
                "approval",
                "data_access",
                "memory",
                "metrics",
                "auth",
                "config",
                "system"
              ]
            },
            "target": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "minLength": 1
                },
                "id": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "type",
                "id"
              ],
              "additionalProperties": false
            },
            "outcome": {
              "type": "string",
              "enum": [
                "success",
                "failure",
                "denied",
                "partial"
              ]
            },
            "errorCode": {
              "type": "string",
              "minLength": 1
            },
            "errorMessage": {
              "type": "string"
            },
            "riskLevel": {
              "type": "string",
              "enum": [
                "low",
                "medium",
                "high"
              ]
            },
            "cost": {
              "type": "object",
              "properties": {
                "tokensIn": {
                  "type": "integer",
                  "minimum": 0
                },
                "tokensOut": {
                  "type": "integer",
                  "minimum": 0
                },
                "currency": {
                  "type": "string",
                  "minLength": 3,
                  "maxLength": 3
                },
                "amount": {
                  "type": "number",
                  "minimum": 0
                }
              },
              "additionalProperties": false
            },
            "durationMs": {
              "type": "number",
              "minimum": 0
            },
            "occurredAt": {
              "type": "string",
              "format": "date-time"
            },
            "details": {
              "type": "object",
              "additionalProperties": {}
            },
            "tags": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "content": {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]{0,63}$"
                },
                "text": {
                  "type": "string",
                  "maxLength": 16384
                },
                "truncated": {
                  "type": "boolean"
                },
                "originalLength": {
                  "type": "integer",
                  "minimum": 0
                },
                "redactions": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "kind",
                "text",
                "truncated",
                "originalLength",
                "redactions"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "version",
            "eventId",
            "traceId",
            "spanId",
            "workspaceId",
            "actor",
            "service",
            "action",
            "category",
            "outcome",
            "occurredAt",
            "details"
          ],
          "additionalProperties": false
        }
      },
      "$schema": "http://json-schema.org/draft-07/schema#"
    },

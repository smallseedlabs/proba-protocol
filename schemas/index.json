    "ContextRequest": {
      "$ref": "#/definitions/ContextRequest",
      "definitions": {
        "ContextRequest": {
          "type": "object",
          "properties": {
            "traceId": {
              "type": "string",
              "format": "uuid"
            },
            "workspaceId": {
              "type": "string",
              "minLength": 1
            },
            "userId": {
              "$ref": "#/definitions/ContextRequest/properties/traceId"
            },
            "goalId": {
              "$ref": "#/definitions/ContextRequest/properties/traceId"
            },
            "threadId": {
              "$ref": "#/definitions/ContextRequest/properties/traceId"
            },
            "stepId": {
              "type": "string",
              "minLength": 1
            },
            "stepType": {
              "type": "string",
              "enum": [
                "interpret_message",
                "clarify",
                "plan_goal",
                "propose_budget",
                "handle_approval",
                "launch_campaign",
                "review_performance",
                "explain_decision"
              ]
            },
            "needs": {
              "type": "array",
              "items": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "const": "memory_search"
                      },
                      "query": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 500
                      },
                      "limit": {
                        "type": "integer",
                        "exclusiveMinimum": 0,
                        "maximum": 20,
                        "default": 5
                      }
                    },
                    "required": [
                      "kind",
                      "query"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "const": "analytics_compare"
                      },
                      "campaignIds": {
                        "type": "array",
                        "items": {
                          "$ref": "#/definitions/ContextRequest/properties/traceId"
                        },
                        "minItems": 1,
                        "maxItems": 10
                      },
                      "metric": {
                        "type": "string",
                        "enum": [
                          "impressions",
                          "clicks",
                          "spend",
                          "conversions",
                          "ctr",
                          "cpc",
                          "cpa"
                        ]
                      },
                      "window": {
                        "type": "string",
                        "enum": [
                          "1d",
                          "7d",
                          "14d",
                          "30d",
                          "90d"
                        ]
                      }
                    },
                    "required": [
                      "kind",
                      "campaignIds",
                      "metric",
                      "window"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "const": "audit_trace"
                      },
                      "traceId": {
                        "$ref": "#/definitions/ContextRequest/properties/traceId"
                      }
                    },
                    "required": [
                      "kind",
                      "traceId"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "const": "conversation_before"
                      },
                      "cursor": {
                        "type": "string",
                        "minLength": 1
                      },
                      "limit": {
                        "type": "integer",
                        "exclusiveMinimum": 0,
                        "maximum": 50,
                        "default": 20
                      }
                    },
                    "required": [
                      "kind",
                      "cursor"

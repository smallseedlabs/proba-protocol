              ]
            },
            "cost": {
              "type": "object",
              "properties": {
                "tokensIn": {
                  "type": "integer",
                  "minimum": 0
                },
                "tokensOut": {
                  "type": "integer",
                  "minimum": 0
                },
                "currency": {
                  "type": "string",
                  "minLength": 3,
                  "maxLength": 3
                },
                "amount": {
                  "type": "number",
                  "minimum": 0
                }
              },
              "additionalProperties": false
            },
            "durationMs": {
              "type": "number",
              "minimum": 0
            },
            "occurredAt": {
              "type": "string",
